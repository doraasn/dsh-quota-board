{
  "name": "@local/dsh-quota-panel",
  "description": "DSH 侧栏额度看板：Codex 额度 + 中转站 / 官方 API 余额",
  "version": "0.10.30",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
